<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620" prefWidth="1000" styleClass="root" stylesheets="@../css/base.css, @../css/layout.css, @../css/components.css, @../css/subject.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.Student.RegisterSubjectController">

    <left>
        <VBox maxWidth="240" minWidth="240" prefWidth="240" spacing="20" styleClass="sidebar">
            <padding>
                <Insets bottom="24" left="20" right="20" top="28" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="logo-icon" text="🎓" />
                <VBox spacing="2">
                    <Label styleClass="logo-title" text="Student Portal" />
                    <Label styleClass="logo-subtitle" text="Hệ thống sinh viên" />
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-separator" />

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Button fx:id="btnHome" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button" text="  👤   Thông tin cá nhân" />
                <Button fx:id="btnScore" maxWidth="Infinity" onAction="#showScore" styleClass="nav-button" text="  📊   Kết quả học tập" />
                <Button fx:id="btnSchedule" maxWidth="Infinity" onAction="#showSchedule" styleClass="nav-button" text="  📅   Lịch học" />
                <Button maxWidth="Infinity" styleClass="nav-active" text="📚 Đăng ký môn" />
                <Button fx:id="btnNote" maxWidth="Infinity" onAction="#showNote" styleClass="nav-button" text="  📄   Ghi chú" />
            </VBox>

            <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" prefHeight="35.0" prefWidth="199.0" styleClass="logout-button" text="  ↪   Đăng xuất" />
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="main-container">

            <!-- Bộ lọc -->
            <GridPane hgap="16" styleClass="filter-box" vgap="8">
                <Label text="Chọn Khóa/Khối:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cbKhoa" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Label text="Chọn Môn Học:" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <ComboBox fx:id="cbMon" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- Chọn lớp -->
            <VBox spacing="10" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="section-title" text="Chọn Lớp:" />
                </HBox>

                <TableView fx:id="lopHocPhanTable" prefHeight="179.0" prefWidth="728.0" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colLop" prefWidth="260" text="Lớp" />
                        <TableColumn fx:id="colGiangVien" prefWidth="220" text="Giảng viên" />
                        <TableColumn fx:id="colDiaDiem" prefWidth="180" text="Địa điểm" />
                        <TableColumn fx:id="colThoiGian" prefWidth="160" text="Thời gian" />
                        <TableColumn fx:id="colNgayHoc" prefWidth="240" text="Các ngày học" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Lịch học ảo -->
            <VBox spacing="10" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="section-title" text="Lịch học ảo" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnClear" styleClass="danger-button" text="Xóa lịch" />
                </HBox>

                <GridPane fx:id="scheduleGrid" hgap="10" prefHeight="173.0" prefWidth="728.0" styleClass="schedule-grid" vgap="10" />
            </VBox>

            <!-- Button cuối -->
            <HBox spacing="12" styleClass="action-bar">
                <Button fx:id="btnSave" styleClass="primary-button" text="💾 Save" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnExport" styleClass="success-button" text="📤 Export" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnImport" styleClass="warning-button" text="📥 Import" HBox.hgrow="ALWAYS" />
            </HBox>

        </VBox>
    </center>


</BorderPane>
