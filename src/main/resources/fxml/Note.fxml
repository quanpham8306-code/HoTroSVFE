<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="878.0" prefWidth="1032.0" styleClass="note-root" stylesheets="@../css/note.css, @../css/components.css,@../css/layout.css,@../css/base.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.Student.NoteController">
    <left>
        <VBox maxWidth="240.0" minWidth="240" prefHeight="523.0" prefWidth="743.0" spacing="20" styleClass="sidebar">
            <padding>
                <Insets bottom="24" left="20" right="20" top="28" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🎓" textFill="#152bd4">
               <font>
                  <Font size="67.0" />
               </font></Label>
                <VBox spacing="2">
                    <Label styleClass="logo-title" text="Student Portal" />
                    <Label styleClass="logo-subtitle" text="Hệ thống sinh viên" />
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-separator" />

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Button fx:id="btnHome" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button" text="  👤   Thông tin cá nhân" />
                <Button fx:id="btnScore" maxWidth="Infinity" onAction="#showScore" styleClass="nav-button" text="  📊   Kết quả học tập" />
                <Button fx:id="btnSchedule" maxWidth="Infinity" onAction="#showSchedule" styleClass="nav-button" text="  📅   Lịch học" />
                <Button fx:id="btnSubject" maxWidth="Infinity" onAction="#showSubject" styleClass="nav-button" text="📚 Đăng ký môn" />
                <Button maxWidth="Infinity" styleClass="nav-active" text="  📄   Ghi chú" />
            </VBox>

            <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" prefHeight="35.0" prefWidth="199.0" styleClass="logout-button" text="  ↪   Đăng xuất" />
        </VBox>
    </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
          <HBox alignment="CENTER_LEFT" prefHeight="95.0" prefWidth="792.0" spacing="12" styleClass="note-header">
              <VBox spacing="4">
                  <Label styleClass="page-title" text="Ghi chú học tập" />
                  <Label styleClass="page-subtitle" text="Lưu lại các nội dung quan trọng trong quá trình học" />
              </VBox>
      
                 <Region HBox.hgrow="ALWAYS" />
      
                 <Button fx:id="btnNewNote" onAction="#newNote" styleClass="primary-button" text="+ Ghi chú mới" />
          </HBox>
            <HBox prefHeight="1080.0" prefWidth="1920.0">
               <children>
                  <VBox prefHeight="760.0" prefWidth="460.0" spacing="16" styleClass="note-editor" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                           <children>
                              <Label styleClass="section-title" text="Chi tiết ghi chú" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblStatus" styleClass="updated-label" text="Chưa lưu" />
                           </children>
                        </HBox>
                        <TextField fx:id="txtTitle" promptText="Nhập tiêu đề ghi chú..." styleClass="title-field" />
                        <TextField fx:id="txtTag" promptText="Tag ví dụ: Java, Spring Boot, Lịch học..." styleClass="tag-field" />
                        <TextArea fx:id="txtNote" prefHeight="398.0" prefWidth="748.0" promptText="Nhập nội dung ghi chú tại đây..." styleClass="content-area" wrapText="true" VBox.vgrow="ALWAYS" />
                        <HBox alignment="BOTTOM_LEFT" spacing="12">
                           <children>
                              <Button fx:id="btnCancel" onAction="#cancel" styleClass="danger-button" text="Hủy" />
                              <Button fx:id="btnSave" onAction="#saveNote" styleClass="primary-button" text="Lưu ghi chú" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="779.0" prefWidth="511.0" styleClass="note-editor">
                     <children>
                        <HBox alignment="CENTER_RIGHT" spacing="12">
                           <children>
                              <TextField fx:id="txtSearch" prefHeight="56.0" prefWidth="307.0" promptText="Tìm kiếm ghi chú..." styleClass="search-field" />
                              <Button fx:id="btnFind" onAction="#findNote" styleClass="primary-button" text="Tìm" />
                           </children>
                        </HBox>
                        <TableView fx:id="noteTable" prefHeight="792.0" prefWidth="378.0" styleClass="modern-table">
                          <columns>
                            <TableColumn fx:id="colDate" prefWidth="116.0" text="Thời gian" />
                              <TableColumn fx:id="colTag" prefWidth="116.0" text="Tag" />
                            <TableColumn fx:id="colTitle" prefWidth="260.0" text="Tiêu đề" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="12">
                           <children>
                              <Button fx:id="btnDelete" onAction="#deleteNote" styleClass="danger-button" text="Xóa ghi chú" />
                              <Button fx:id="btnXemAll" onAction="#seeAll" styleClass="primary-button" text="Xem tất cả" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>

</BorderPane>
