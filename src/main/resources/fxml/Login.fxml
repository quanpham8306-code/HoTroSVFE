<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="900.0" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.LoginController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="300.0" layoutY="84.0" prefHeight="383.0" prefWidth="300.0" styleClass="login-box">
         <children>
            <Label alignment="TOP_CENTER" contentDisplay="CENTER" prefHeight="70.0" prefWidth="300.0" text="Login">
               <font>
                  <Font size="50.0" />
               </font>
            </Label>
            <Label alignment="TOP_CENTER" prefHeight="58.0" prefWidth="300.0" text="Please enter your username and password">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtusername" alignment="CENTER" prefHeight="50.0" prefWidth="300.0" promptText="Username">
               <font>
                  <Font size="20.0" />
               </font>
            </TextField>
            <PasswordField fx:id="txtppassword" alignment="CENTER" prefHeight="50.0" prefWidth="300.0" promptText="Password">
               <font>
                  <Font size="20.0" />
               </font>
            </PasswordField>
            <Label prefHeight="38.0" prefWidth="40.0" />
            <Button fx:id="btnLogin" contentDisplay="CENTER" mnemonicParsing="false" onAction="#submit" prefHeight="36.0" prefWidth="76.0" text="Login" textAlignment="CENTER">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
