<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768" prefWidth="1366" stylesheets="@../../css/Admin.css,@../../css/layout.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.Admin.RegisteredClassController">

    <left>
        <VBox maxWidth="240" minWidth="240" prefWidth="240" spacing="18" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="18" right="18" top="24" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="logo-icon" text="🎓" />
                <VBox spacing="2">
                    <Label styleClass="logo-title" text="Admin Portal" />
                    <Label styleClass="logo-subtitle" text="Hệ thống quản trị" />
                </VBox>
            </HBox>

            <Separator />

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Button fx:id="btnHomeAdmin" onAction="#showHomeAd" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnSV" onAction="#showSV" styleClass="nav-button" text="👨‍🎓 Sinh viên" />
                <Button fx:id="btnMh" onAction="#showMh" styleClass="nav-button" text="📚 Môn học" />
                <Button fx:id="btnLHP" onAction="#showLHP" styleClass="nav-button" text="🏫 Lớp học phần" />
                <Button fx:id="btnScore" onAction="#showScore" styleClass="nav-button" text="📝 Điểm" />
                <Button styleClass="nav-active" text="📋 Chi tiết lớp học phần" />
            <Button fx:id="btnAccount" onAction="#showAccount" styleClass="nav-button" text="👤 Tài khoản" />
            </VBox>

            <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="42.0" prefWidth="391.0" styleClass="nav-active" text="↪ Đăng xuất" />
        </VBox>
    </left>

    <center>
        <VBox spacing="22" styleClass="main-bg">
            <padding>
                <Insets bottom="32" left="32" right="32" top="28" />
            </padding>

            <Label styleClass="page-title" text="Chi tiết lớp học phần" />

            <VBox spacing="18" styleClass="table-card" VBox.vgrow="ALWAYS">

                <HBox spacing="15">
                    <TextField fx:id="txtMaSv" prefHeight="23.0" prefWidth="182.0" promptText="Nhập mã sinh viên, ví dụ SV001" />

                    <TextField fx:id="txtMaLopHP" prefHeight="23.0" prefWidth="178.0" promptText="Nhập mã lớp HP, ví dụ LHP001" />

                    <Button onAction="#searchBy" prefHeight="36.0" prefWidth="180.0" styleClass="primary-btn" text="Xem danh sách sinh viên" />

                    <Button onAction="#addStudentToClass" styleClass="primary-btn" text="+ Thêm vào lớp" />

                    <Button onAction="#removeStudentFromClass" prefHeight="36.0" prefWidth="114.0" styleClass="delete-btn" text="Xóa khỏi lớp" />
               <Button fx:id="importStudent" onAction="#impoprtStudentToClass" prefHeight="36.0" prefWidth="105.0" styleClass="import-btn" text="Import Excel" />
                </HBox>

                <Separator />

                <TableView fx:id="tableClass" styleClass="student-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaSv" prefWidth="196.00000607967377" text="Mã sinh viên" />
                        <TableColumn fx:id="colName" prefWidth="194.39996337890625" text="Họ tên" />
                        <TableColumn fx:id="colLop" prefWidth="172.00003051757812" text="Lớp " />
                        <TableColumn fx:id="colSex" prefWidth="110.39996337890625" text="Giới tính" />
                        <TableColumn fx:id="colNganh" prefWidth="197.60003662109375" text="Ngành" />
                        <TableColumn fx:id="colKhoa" prefWidth="143.9998779296875" text="Khóa" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>

            </VBox>
        </VBox>
    </center>
</BorderPane>
